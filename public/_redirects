# This site (Netlify) serves the homepage. The homepage and Astro's own assets
# (/_astro/*, /assets/*, /uploads/*, /robots.txt, /sitemap*.xml) are real files,
# so Netlify serves them directly — the rule below never touches them.
#
# The webinar funnel moved to the /webinar/<slug>/ convention so the URL names
# which webinar it is. These keep any already-shared links working. Above the
# catch-all, or they would be proxied to Webflow and 404.
/webinar/registration      /webinar/spe-2026/             301
/webinar/registration/     /webinar/spe-2026/             301
/webinar/thank-you         /webinar/spe-2026/thank-you/   301
/webinar/thank-you/        /webinar/spe-2026/thank-you/   301

# /api/* is served by this site's own Netlify Functions. It MUST stay above the
# catch-all below: the first matching rule wins, and without this the webinar
# registration POST is proxied to Webflow, which answers 405 Not Allowed.
/api/webinar/register  /.netlify/functions/webinar-register  200

# Every OTHER path is invisibly proxied (status 200 = rewrite, not redirect) to
# the Webflow site published at site.labscubed.com, so all existing
# labscubed.com/... pages keep working at the exact same URLs.
/*  https://site.labscubed.com/:splat  200
