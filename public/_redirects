# This site (Netlify) serves all of labscubed.com. Pages and Astro's own assets
# (/_astro/*, /assets/*, /uploads/*, /robots.txt, /sitemap*.xml) are real files,
# so Netlify serves them directly; the rules below cover old URL shapes.
#
# Webinar URLs are /webinar/<topic>-<mon>-<year>/ so the path says which webinar
# AND when it ran — next year's SPE gets its own URL rather than colliding.
# These keep every earlier shape of the URL working. They must stay above the
# catch-all, or they would be proxied to Webflow and 404.
/webinar/registration              /webinar/spe-oct-2026/                    301
/webinar/registration/             /webinar/spe-oct-2026/                    301
/webinar/thank-you                 /webinar/spe-oct-2026/thank-you/          301
/webinar/thank-you/                /webinar/spe-oct-2026/thank-you/          301
/webinar/spe-2026                  /webinar/spe-oct-2026/                    301
/webinar/spe-2026/                 /webinar/spe-oct-2026/                    301
/webinar/spe-2026/thank-you        /webinar/spe-oct-2026/thank-you/          301
/webinar/spe-2026/thank-you/       /webinar/spe-oct-2026/thank-you/          301
/webinar/automation-ai-2026        /webinar/automation-ai-nov-2026/          301
/webinar/automation-ai-2026/       /webinar/automation-ai-nov-2026/          301
/webinar/automation-ai-2026/thank-you   /webinar/automation-ai-nov-2026/thank-you/  301
/webinar/automation-ai-2026/thank-you/  /webinar/automation-ai-nov-2026/thank-you/  301

# The two hub pages, pinned explicitly. Static files already win over a
# non-forced redirect, so these are belt-and-braces — but they make the
# behaviour of the bare paths unambiguous rather than leaving them to the
# catch-all below, which answers from Webflow and whose 404 can then be cached
# at the edge and outlive the real page.
/events         /events/index.html          200
/events/        /events/index.html          200
/webinar        /webinar/index.html         200
/webinar/       /webinar/index.html         200
/get-a-quote    /get-a-quote/index.html     200
/get-a-quote/   /get-a-quote/index.html     200
/about-us       /about-us/index.html        200
/about-us/      /about-us/index.html        200
/privacy-policy   /privacy-policy/index.html   200
/privacy-policy/  /privacy-policy/index.html   200
/plastic-testing   /plastic-testing/index.html   200
/plastic-testing/  /plastic-testing/index.html   200
/rubber-testing   /rubber-testing/index.html   200
/rubber-testing/  /rubber-testing/index.html   200

# /api/* is served by this site's own Netlify Functions. It MUST stay above the
# catch-all below: the first matching rule wins, and without this the webinar
# registration POST is proxied to Webflow, which answers 405 Not Allowed.
/api/webinar/register  /.netlify/functions/webinar-register  200
/api/webinar/replay-register  /.netlify/functions/webinar-replay-register  200
/api/webinar/replay-session   /.netlify/functions/webinar-replay-session   200
/api/webinar/question         /.netlify/functions/webinar-question         200
/api/health                   /.netlify/functions/health                   200

# Resources pages migrated off Webflow keep their SEO equity via a 301 to the
# new /resources/<slug> URL, rather than the same-URL swap used for the blog —
# these pages are moving to a genuinely new path, so a redirect is required
# (unlike /blog and /post/<slug>, which kept their exact Webflow URLs).
/astm-d638-iso527-tensile-testing   /resources/astm-d638-iso-527-2-plastic-tensile-testing   301
/astm-d412-iso37-how-to-run-tensile-testing-for-rubber   /resources/astm-d412-iso-37-rubber-tensile-testing   301

# The last pages that only existed on Webflow, retired at the migration
# cutover (2026-09-18) with a 301 to their closest Astro page so any links and
# rankings they had carry over. The old quote thank-you page is replaced by the
# wizard's inline confirmation (which fires the same virtual page view in GA4).
/get-a-quote-thank-you  /get-a-quote/  301
/get-a-quote-thank-you/  /get-a-quote/  301
/hero-lab  /  301
/hero-lab/  /  301
/cube-go-waitlist  /get-a-quote/  301
/cube-go-waitlist/  /get-a-quote/  301
/labscubed-automated-tensile-testing-for-polymer-labs  /plastic-testing/  301
/labscubed-automated-tensile-testing-for-polymer-labs/  /plastic-testing/  301
/astm-d790-iso-178-explained-everything-you-need-to-know-about-plastic-flexural-testing  /post/astm-d790-iso-178-explained-everything-you-need-to-know-about-plastic-flexural-testing  301
/astm-d790-iso-178-explained-everything-you-need-to-know-about-plastic-flexural-testing/  /post/astm-d790-iso-178-explained-everything-you-need-to-know-about-plastic-flexural-testing  301

# Webflow's sitemap lived at /sitemap.xml and is what search engines have on
# file; point them at the Astro sitemap index instead of the proxied old one.
/sitemap.xml  /sitemap-index.xml  301

# Webflow cutover (2026-09-18): the catch-all that proxied every other path
# to the Webflow site (site.labscubed.com) is gone. Every page now lives here,
# and an unknown path gets Netlify's 404 (dist/404.html, src/pages/404.astro).
# Webflow's blog-era listing paths go to the Astro blog rather than a 404.
/blog-category/*   /blog   301
/blog-categories/*  /blog  301
/category/*        /blog   301
