---
// Hero — static section. Headline, sub, hero image with bottom fade, and the
// specimen rail — now SpecimenRail.astro, shared with the product pages.
import SpecimenRail from './SpecimenRail.astro';

// Homepage rail: the mixed plastic + rubber selection.
const railIds = ['astm-d638-i', 'astm-d638-ii', 'iso-527-1a', 'astm-d624-c', 'iso-37-2'];
---
<section class="hero">
  <div class="hero-head">
    <h1 class="hero-h1">Automated tensile testing for polymer and rubber labs.</h1>
    <p class="hero-sub">ISO- and ASTM-compliant automation that delivers repeatable results and frees your team from repetitive testing.</p>
    <div class="hero-img-wrap">
      <!-- LCP element. The 1500w original is only right for a DPR-2 desktop;
           a phone draws this at ~264 CSS px, so `sizes` has to mirror the two
           widths in the CSS below (64vw under 760px, min(55.5vw, 708px) above)
           or the browser over-fetches. Matched by the preload in Base.astro. -->
      <img
        src="/assets/img/media/hero-cubeten-crop-760.webp"
        srcset="/assets/img/media/hero-cubeten-crop-480.webp 480w, /assets/img/media/hero-cubeten-crop-760.webp 760w, /assets/img/media/hero-cubeten-crop.webp 1500w"
        sizes="(max-width: 760px) 64vw, min(55.5vw, 708px)"
        alt="CubeTen automated tensile testing machine"
        class="hero-img"
        loading="eager"
        fetchpriority="high"
        width="1500"
        height="795"
      />
      <div class="hero-img-fade"></div>
    </div>
  </div>

  <SpecimenRail ids={railIds} />
</section>

<style>
  .hero { background: #000; color: #fff; position: relative; overflow: hidden; padding-bottom: 0; }
  .hero-head { max-width: 1312px; margin: 0 auto; padding: 150px 64px 0; box-sizing: border-box; text-align: center; }
  .hero-h1 { font-weight: 700; font-size: 80px; line-height: 1.06; letter-spacing: -0.01em; margin: 0 auto; max-width: 1100px; text-wrap: balance; }
  .hero-sub { margin: 22px auto 0; max-width: 760px; font-size: 18px; line-height: 1.5; color: rgba(255,255,255,0.5); text-wrap: balance; }
  .hero-img-wrap { position: relative; z-index: 1; width: 55.5%; max-width: 708px; margin: 30px auto 0; }
  .hero-img { width: 100%; display: block; height: auto; }
  .hero-img-fade { position: absolute; left: 0; right: 0; bottom: -1px; height: 44%; background: linear-gradient(to top, #000 0%, #02060e 7%, rgba(4,10,22,0.55) 24%, rgba(4,10,22,0) 55%); pointer-events: none; }

  @media (max-width: 760px) {
    .hero-head { padding: 110px 20px 0; }
    .hero-h1 { font-size: 40px; }
    .hero-sub { font-size: 15px; }
    .hero-img-wrap { width: 64%; margin: 24px auto 0; }
  }
</style>
