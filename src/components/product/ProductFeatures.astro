---
// ProductFeatures — framework section 02: heading + 3–4 benefit cards.
import ProductSection from './ProductSection.astro';
import ProductHeading from './ProductHeading.astro';

interface Props {
  heading: string;
  sub?: string;
  items: { icon: string; title: string; body: string }[];
}
const { heading, sub, items } = Astro.props;
---
<ProductSection bg="#fff">
  <ProductHeading heading={heading} sub={sub} />
  <div class="pp-feat" style={`--cols:${items.length}`}>
    {items.map((it) => (
      <div class="pp-feat__card">
        <span class="pp-feat__icon"><img src={it.icon} alt="" width="28" height="28" loading="lazy" /></span>
        <h3 class="pp-feat__title">{it.title}</h3>
        <p class="pp-feat__body">{it.body}</p>
      </div>
    ))}
  </div>
</ProductSection>

<style>
  .pp-feat { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: 28px; margin-top: 48px; }
  .pp-feat__card { padding: 32px; border-radius: 24px; background: var(--lc-gray-100); }
  .pp-feat__icon { width: 56px; height: 56px; border-radius: 8px; background: #fff; display: inline-flex; align-items: center; justify-content: center; box-shadow: var(--shadow-edge); }
  .pp-feat__title { font-weight: 500; font-size: 22px; letter-spacing: -0.01em; margin: 22px 0 0; color: var(--lc-ink); }
  .pp-feat__body { margin: 10px 0 0; font-size: 15px; line-height: 1.5; color: var(--text-muted); }
  @media (max-width: 760px) {
    .pp-feat { grid-template-columns: 1fr; gap: 16px; margin-top: 32px; }
    .pp-feat__card { padding: 26px; }
  }
</style>
