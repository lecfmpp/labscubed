---
// About hero — black band, eyebrow, H1 and the "Discover Our Story" video.
// Ported from the about_handoff kit; the JS useIsMobile branches are CSS
// media queries here so the server HTML is already correct on a phone.
import VideoFacade from '../islands/VideoFacade.tsx';
---
<section class="ab-hero">
  <span class="ab-hero__glow" aria-hidden="true"></span>
  <div class="ab-hero__inner">
    <div class="ab-hero__eyebrow">About LabsCubed</div>
    <h1 class="ab-hero__h1">At LabsCubed, we believe in the power of materials to change our world</h1>
    <div class="ab-hero__video">
      {/* Above the fold, and the only thing to click here — hydrate on load. */}
      <VideoFacade client:load id="8IuGJsjw2AE" title="Discover Our Story" />
    </div>
  </div>
</section>

<style>
  .ab-hero { background: #000; color: #fff; position: relative; overflow: hidden; }
  .ab-hero__glow {
    position: absolute; top: -280px; left: 50%; transform: translateX(-50%);
    width: 1100px; height: 700px; pointer-events: none;
    background: radial-gradient(closest-side, rgba(23,221,197,0.16), rgba(23,221,197,0));
  }
  .ab-hero__inner { position: relative; max-width: 1312px; margin: 0 auto; padding: 170px 64px 120px; box-sizing: border-box; text-align: center; }
  .ab-hero__eyebrow { font-weight: 700; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
  .ab-hero__h1 { font-weight: 700; font-size: 80px; line-height: 1.05; letter-spacing: -0.03em; margin: 24px auto 0; max-width: 1080px; text-wrap: balance; }
  .ab-hero__video { margin-top: 64px; }

  @media (max-width: 760px) {
    .ab-hero__inner { padding: 110px 20px 72px; }
    .ab-hero__h1 { font-size: 40px; }
    .ab-hero__video { margin-top: 40px; }
  }
</style>
