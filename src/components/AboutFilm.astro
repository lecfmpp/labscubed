---
// Black band carrying the second story film, now framed as the forward-looking
// close of the page: "Building the Autonomous Lab" (Mo'min's About Page doc).
import VideoFacade from '../islands/VideoFacade.tsx';
---
<section class="ab-film">
  <div class="ab-film__inner">
    <div class="ab-film__head">
      <div class="ab-film__eyebrow">What comes next</div>
      <h2 class="ab-film__h2">Building the Autonomous Lab</h2>
      <p class="ab-film__body">We started LabsCubed to make testing simpler. Today, we're building toward something much bigger: laboratories that can operate with greater autonomy. By combining robotics, AI-powered vision, predictive maintenance, and conversational data analytics, we're turning automated testing into an intelligent workflow—one that can run, learn, and give teams more time to focus on what comes next.</p>
    </div>
    {/* Well below the fold and inert until clicked — hydrate when idle. */}
    <VideoFacade client:idle id="eWPbdBoOrJ4" title="Building the Autonomous Lab" />
  </div>
</section>

<style>
  .ab-film { background: #000; color: #fff; }
  .ab-film__inner { max-width: 1312px; margin: 0 auto; padding: 120px 64px; box-sizing: border-box; }
  .ab-film__head { text-align: center; max-width: 820px; margin: 0 auto 64px; }
  .ab-film__eyebrow { font-weight: 700; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
  .ab-film__h2 { font-weight: 700; font-size: 56px; line-height: 1.06; letter-spacing: -0.03em; margin: 18px 0 0; text-wrap: balance; }
  .ab-film__body { font-weight: 300; font-size: 18px; line-height: 1.6; color: rgba(255,255,255,0.72); margin: 24px auto 0; max-width: 720px; text-wrap: pretty; }
  @media (max-width: 760px) {
    .ab-film__inner { padding: 72px 20px; }
    .ab-film__head { margin-bottom: 40px; }
    .ab-film__h2 { font-size: 34px; }
    .ab-film__body { font-size: 15px; }
  }
</style>
