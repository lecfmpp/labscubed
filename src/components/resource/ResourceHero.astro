---
// ResourceHero — black full-bleed hero: breadcrumbs, optional eyebrow badge,
// H1 (with a teal-accented lead-in), deck, meta strip (reading time + updated
// date), and up to two CTAs. Required on every resource page.
import Badge from './Badge.astro';
import Button from '../Button.astro';

interface Crumb { label: string; href?: string }
interface Cta { label: string; href: string }
interface Props {
  eyebrow?: string;
  headlineAccent: string;
  headlineRest: string;
  deck: string;
  updated: string;
  readingMinutes: number;
  breadcrumbs: Crumb[];
  primaryCta?: Cta;
  secondaryCta?: Cta;
}
const { eyebrow, headlineAccent, headlineRest, deck, updated, readingMinutes, breadcrumbs, primaryCta, secondaryCta } = Astro.props;
const updatedLabel = new Date(updated + 'T00:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<section class="rs-hero">
  <div class="rs-hero__inner">
    <nav aria-label="Breadcrumb" class="rs-crumbs">
      <ol>
        {breadcrumbs.map((b, i) => (
          <li>
            {b.href ? <a href={b.href}>{b.label}</a> : <span aria-current="page">{b.label}</span>}
            {i < breadcrumbs.length - 1 && <span aria-hidden="true" class="rs-crumbs__sep">/</span>}
          </li>
        ))}
      </ol>
    </nav>
    {eyebrow && <Badge variant="subtle">{eyebrow}</Badge>}
    <h1 class="rs-hero__h1"><span class="rs-hero__accent">{headlineAccent}</span>{headlineRest}</h1>
    <p class="rs-hero__deck">{deck}</p>
    <div class="rs-hero__meta">
      <span>{readingMinutes} min read</span>
      <span class="rs-hero__dot" aria-hidden="true"></span>
      <span>Updated <time datetime={updated}>{updatedLabel}</time></span>
    </div>
    {(primaryCta || secondaryCta) && (
      <div class="rs-hero__ctas">
        {primaryCta && <Button variant="primary" href={primaryCta.href}>{primaryCta.label}</Button>}
        {secondaryCta && <Button variant="ghost" arrow={false} href={secondaryCta.href} target="_blank" rel="noopener">{secondaryCta.label}</Button>}
      </div>
    )}
  </div>
</section>
<style>
  .rs-hero { background: #000; color: #fff; }
  .rs-hero__inner { max-width: 1312px; margin: 0 auto; padding: 72px 64px 96px; box-sizing: border-box; }
  .rs-crumbs { margin-bottom: 22px; }
  .rs-crumbs ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0; padding: 0; font-size: 13px; }
  .rs-crumbs li { display: flex; align-items: center; gap: 8px; }
  .rs-crumbs a { color: rgba(255,255,255,0.5); text-decoration: none; }
  .rs-crumbs a:hover { color: rgba(255,255,255,0.8); }
  .rs-crumbs [aria-current="page"] { color: rgba(255,255,255,0.85); }
  .rs-crumbs__sep { color: rgba(255,255,255,0.28); }
  .rs-hero__h1 { font-weight: 700; font-size: 68px; line-height: 1.05; letter-spacing: -0.03em; margin: 24px 0 0; max-width: 1040px; text-wrap: pretty; }
  .rs-hero__accent { color: var(--lc-teal); }
  .rs-hero__deck { font-weight: 300; font-size: 20px; line-height: 1.6; color: rgba(255,255,255,0.6); margin: 28px 0 0; max-width: 720px; }
  .rs-hero__meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 28px; font-size: 13px; font-weight: 500; letter-spacing: 0.02em; color: rgba(255,255,255,0.55); }
  .rs-hero__dot { width: 4px; height: 4px; border-radius: 50%; background: rgba(255,255,255,0.25); }
  .rs-hero__ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 36px; }

  @media (max-width: 860px) {
    .rs-hero__inner { padding: 40px 20px 64px; }
    .rs-hero__h1 { font-size: 36px; }
    .rs-hero__deck { font-size: 17px; }
  }
</style>
