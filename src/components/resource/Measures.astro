---
// Measures — 3-up numbered cards on the subtle grey surface.
import PageSection from './PageSection.astro';
import Heading from './Heading.astro';
import P from './P.astro';

interface Item { title: string; body: string }
interface Props {
  id: string; heading: string; intro: string; items: Item[]; outro?: string;
  note?: string; sideImage?: { src: string; alt: string };
}
const { id, heading, intro, items, outro, note, sideImage } = Astro.props;
---
<PageSection bg="subtle" pad={104}>
  <Heading id={id}>{heading}</Heading>
  <P style="margin-top:18px;">{intro}</P>
  <div class="rs-measures">
    {items.map((it, i) => (
      <div class="rs-measures__card">
        <span class="rs-measures__n">{String(i + 1).padStart(2, '0')}</span>
        <div class="rs-measures__t">{it.title}</div>
        <p class="rs-measures__d">{it.body}</p>
      </div>
    ))}
  </div>
  {outro && <P style="margin-top:40px;">{outro}</P>}
  {(note || sideImage) && (
    <div class="rs-measures__trailing">
      <div class="rs-measures__note-col">
        {note && (
          <div class="rs-measures__note">
            <strong>Note:</strong> {note}
          </div>
        )}
      </div>
      {sideImage && <img src={sideImage.src} alt={sideImage.alt} class="rs-measures__img" />}
    </div>
  )}
</PageSection>
<style>
  .rs-measures { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 44px; }
  .rs-measures__card { display: flex; flex-direction: column; gap: 14px; padding: 32px; border-radius: var(--radius-card); background: var(--surface-card); box-shadow: var(--shadow-edge); }
  .rs-measures__n { font-weight: 700; font-size: 13px; letter-spacing: 0.08em; color: var(--lc-teal-deep); }
  .rs-measures__t { font-weight: 600; font-size: 19px; letter-spacing: -0.01em; line-height: 1.3; color: var(--lc-ink); }
  .rs-measures__d { font-weight: 300; font-size: 15.5px; line-height: 1.6; color: var(--text-muted); margin: 0; }
  .rs-measures__trailing { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; margin-top: 56px; }
  .rs-measures__note { padding: 24px 28px; border-radius: var(--radius-card); border: 1px solid var(--lc-line-strong); background: var(--surface-card); font-size: 15.5px; line-height: 1.6; color: var(--lc-ink); }
  .rs-measures__note strong { font-weight: 700; }
  .rs-measures__img { width: 100%; display: block; border-radius: var(--radius-card); }
  @media (max-width: 860px) {
    .rs-measures { grid-template-columns: 1fr; }
    .rs-measures__trailing { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
