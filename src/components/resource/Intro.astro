---
// Intro — single 820px prose column + key-takeaways box. Required-ish first
// body section; imports blog-assets.css for the .lcb-takeaways kit (the
// exact same box used in blog posts).
import '../../styles/blog-assets.css';
import PageSection from './PageSection.astro';
import Heading from './Heading.astro';
import P from './P.astro';

interface Props { id: string; heading: string; paragraphs: string[]; standardLabel?: string; standardHref?: string; takeaways: string[] }
const { id, heading, paragraphs, standardLabel, standardHref, takeaways } = Astro.props;
---
<PageSection pad={96}>
  <div class="rs-intro">
    <Heading id={id}>{heading}</Heading>
    {paragraphs.map((p) => <P>{p}</P>)}
    {standardHref && (
      <div class="rs-intro__standard">
        Official Standard: <a href={standardHref} target="_blank" rel="noopener">Click here</a>
      </div>
    )}
    <div class="lcb" style="margin:48px 0 0;">
      <aside class="lcb-takeaways">
        <h3 class="lcb-takeaways__title">Key takeaways</h3>
        <ul>
          {takeaways.map((t) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
              {t}
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</PageSection>
<style>
  .rs-intro { display: flex; flex-direction: column; gap: 24px; max-width: 820px; }
  .rs-intro__standard { font-size: 16px; color: var(--lc-ink); }
  .rs-intro__standard a { font-weight: 500; }
</style>
