---
// Related — 3-up linked cards, hover lift. Point hrefs at real /resources
// pages as they ship.
import PageSection from './PageSection.astro';
import Heading from './Heading.astro';

interface Item { eyebrow: string; title: string; desc: string; href: string; img: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<PageSection bg="subtle" pad={104}>
  <Heading id="related">Related resources</Heading>
  <div class="rs-related">
    {items.map((c) => (
      <a class="rs-related__card" href={c.href}>
        <div class="rs-related__plate"><img src={c.img} alt="" /></div>
        <div class="rs-related__body">
          <span class="rs-related__eyebrow">{c.eyebrow}</span>
          <div class="rs-related__t">{c.title}</div>
          <p class="rs-related__d">{c.desc}</p>
        </div>
      </a>
    ))}
  </div>
</PageSection>
<style>
  .rs-related { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 44px; }
  .rs-related__card { display: flex; flex-direction: column; border-radius: var(--radius-card); background: var(--surface-card); box-shadow: var(--shadow-edge); overflow: hidden; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease; }
  .rs-related__card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(0,0,0,0.08); }
  .rs-related__plate { padding: 20px; background: var(--lc-gray-100); }
  .rs-related__plate img { width: 100%; height: 128px; object-fit: contain; display: block; }
  .rs-related__body { display: flex; flex-direction: column; gap: 10px; padding: 28px; }
  .rs-related__eyebrow { font-weight: 700; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lc-teal-deep); }
  .rs-related__t { font-weight: 600; font-size: 19px; letter-spacing: -0.01em; line-height: 1.3; color: var(--lc-ink); }
  .rs-related__d { font-weight: 300; font-size: 15.5px; line-height: 1.6; color: var(--text-muted); margin: 0; }
  @media (max-width: 860px) {
    .rs-related { grid-template-columns: 1fr; }
  }
</style>
