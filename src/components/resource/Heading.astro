---
// H2/H3 for resource pages. H2 carries scroll-margin-top so a jump from the
// TOC box lands with clearance above the heading.
interface Props { level?: 2 | 3; light?: boolean; id?: string; style?: string }
const { level = 2, light = false, id, style = '' } = Astro.props;
const Tag = level === 3 ? 'h3' : 'h2';
const color = light ? '#fff' : 'var(--lc-ink)';
const base = level === 3
  ? `font-weight:600;font-size:24px;letter-spacing:-0.02em;line-height:1.2;margin:0;color:${color};`
  : `font-weight:700;font-size:48px;letter-spacing:-0.03em;line-height:1.1;margin:0;color:${color};text-wrap:pretty;`;
---
<Tag id={id} class={level === 2 && id ? 'rs-h2' : undefined} style={`${base}${style}`}>
  <slot />
</Tag>
<style>
  .rs-h2 { scroll-margin-top: 96px; }
  @media (max-width: 860px) {
    h2.rs-h2 { font-size: 30px !important; }
  }
</style>
