---
// Setup — 3-step, alternating image/text rows with GIFs.
import Section from './Section.astro';

// GIFs converted to MP4 (Lighthouse "use video for animated content" + huge
// payload win). Each loops muted like the original GIF; poster paints instantly.
const steps = [
  { n: '01', vid: '/assets/img/media/step1-load-samples.mp4', poster: '/assets/img/media/step1-load-samples-poster.webp', w: 312, h: 176, title: 'Load up to 15 Samples at a time', body: 'Place ASTM or ISO standard specimens onto the autonomous dual-gripper carousel.' },
  { n: '02', vid: '/assets/img/media/step2-setup-tray-screen.mp4', poster: '/assets/img/media/step2-setup-tray-screen-poster.webp', w: 314, h: 176, title: 'Set Parameters, press start and walk away', body: 'Input test specifications via the intuitive native touchscreen or remote interface.' },
  { n: '03', vid: '/assets/img/media/short-easy-steps.mp4', poster: '/assets/img/media/short-easy-steps-poster.webp', w: 276, h: 156, title: 'Let it run while your team moves on', body: 'The system automatically grips, pulls, and calculates everything without human intervention — freeing your team’s time for the work only they can do.' },
];
---
<Section bg="#fff">
  <div class="setup-inner">
    <div class="setup-head">
      <div class="setup-eyebrow">How our testing machines work</div>
      <h2 class="setup-title lc-gradtext">The 3-step setup.</h2>
    </div>
    <div class="setup-rows">
      {steps.map((s, i) => (
        <div class={`setup-row ${i % 2 === 1 ? 'row-odd' : ''}`}>
          <div class="setup-img">
            <!-- src is deliberately held in data-src, not src. `preload="none"`
                 does not survive `autoplay`: the browser has to buffer to honour
                 autoplay, so all three clips (238 KB) were downloading during
                 the initial load for a section that sits well below the fold.
                 The script below attaches the real src once the row nears the
                 viewport; the poster paints immediately either way. -->
            <video data-src={s.vid} poster={s.poster} width={s.w} height={s.h} loop muted playsinline preload="none" aria-label={s.title}></video>
          </div>
          <div class="setup-text">
            <div class="setup-n">{s.n}</div>
            <h3 class="setup-h3">{s.title}</h3>
            <p class="setup-body">{s.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</Section>

<script>
  /* Load + play the step clips only once they are close to the viewport.
     Astro bundles and defers this, so it costs nothing on the critical path.

     No-JS fallback is the poster frame, which is the right degradation for
     three decorative loops. rootMargin starts the fetch a screen early so the
     clip is usually running by the time the row is actually read. */
  const videos = document.querySelectorAll<HTMLVideoElement>('.setup-img video[data-src]');

  const start = (video: HTMLVideoElement) => {
    const src = video.dataset.src;
    if (!src) return;
    video.src = src;
    delete video.dataset.src;
    // Autoplay can still be refused (Low Power Mode, data saver). The poster
    // stays up in that case, so swallow the rejection rather than logging.
    video.play().catch(() => {});
  };

  if (!('IntersectionObserver' in window)) {
    videos.forEach(start);
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          start(entry.target as HTMLVideoElement);
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '100% 0px' }
    );
    videos.forEach((v) => io.observe(v));
  }
</script>

<style>
  .setup-inner { padding: 20px 0 130px; }
  .setup-head { text-align: center; }
  .setup-eyebrow { font-size: 18px; color: var(--text-muted); margin-bottom: 14px; }
  .setup-title { font-weight: 600; font-size: 100px; letter-spacing: -0.03em; line-height: 1.1; margin: 0; }
  .setup-rows { margin-top: 90px; display: flex; flex-direction: column; gap: 80px; }
  .setup-row { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .setup-row.row-odd .setup-img { order: 1; }
  .setup-img { border-radius: 16px; overflow: hidden; background: var(--lc-gray-100); box-shadow: var(--shadow-edge); }
  .setup-img img, .setup-img video { width: 100%; display: block; height: auto; }
  .setup-n { font-size: 14px; font-weight: 700; color: var(--lc-teal-deep); letter-spacing: 0.1em; }
  .setup-h3 { font-weight: 700; font-size: 37px; letter-spacing: -0.01em; margin: 10px 0 0; color: var(--lc-ink); }
  .setup-body { margin-top: 14px; font-size: 18px; line-height: 1.55; color: var(--text-muted); font-weight: 300; max-width: 420px; }

  @media (max-width: 760px) {
    .setup-inner { padding: 10px 0 80px; }
    .setup-eyebrow { font-size: 15px; }
    .setup-title { font-size: 44px; }
    .setup-rows { margin-top: 56px; gap: 48px; }
    .setup-row { grid-template-columns: 1fr; gap: 24px; }
    .setup-row.row-odd .setup-img { order: 0; }
    .setup-h3 { font-size: 28px; }
    .setup-body { font-size: 16px; }
  }
</style>
