---
/* /blog and /blog/2, /blog/3 … — the post index.
 *
 * Astro's paginate() gives page 1 the bare `/blog` path, which is the URL the
 * current site already uses and the one the nav links to, so pagination is
 * additive rather than a change of address.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../islands/Nav.tsx';
import Footer from '../../components/Footer.astro';
import '../../styles/blog.css';
import { BLOG_HOST, BLOG_BASE, POST_BASE } from '../../site.mjs';
import {
  getPosts,
  categoryLabel,
  formatDate,
  postDate,
  readTime,
  thumbImage,
  thumbAlt,
} from '../../lib/blog';
import { blogListingSchema } from '../../lib/blog-schema';

/* Page 1 only. Pages 2..n live at /blog/page/N — the listing and individual
   posts are separate top-level paths (/blog vs /post/<slug>), so a paginated
   URL can never collide with a post slug in the first place. */
const posts = await getPosts();
const PAGE_SIZE = 12;
const page = {
  data: posts.slice(0, PAGE_SIZE),
  currentPage: 1,
  lastPage: Math.max(1, Math.ceil(posts.length / PAGE_SIZE)),
  url: { current: BLOG_BASE, prev: undefined, next: posts.length > PAGE_SIZE ? `${BLOG_BASE}/page/2` : undefined },
};

const all = posts;

const title =
  page.currentPage === 1
    ? 'Blog | Automated Tensile Testing Equipment | LabsCubed'
    : `Blog LabsCubed | Page ${page.currentPage}`;
const description =
  "Here, you'll find comprehensive articles and resources on tensile testing and laboratory automation. We share insights on how to implement automated solutions to save time, achieve higher data consistency, and effectively minimize human error in your lab operations.";
const canonical = `${BLOG_HOST}${page.url.current}`;

/* rel=prev/next so paginated pages are read as one series rather than as
   near-duplicate listings competing with each other. */
const headExtra = [
  page.url.prev
    ? `<link rel="prev" href="${BLOG_HOST}${page.url.prev}" />`
    : '',
  page.url.next
    ? `<link rel="next" href="${BLOG_HOST}${page.url.next}" />`
    : '',
].join('');

const categories = [...new Set(all.flatMap((p) => p.categories))].sort();
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={[blogListingSchema(all, BLOG_HOST)]}
  preloadHero={false}
  headExtra={headExtra}
  preloadFont="inter-tight"
>
  <Nav client:load sticky />

  <main class="lc-page">
    <header class="bl-head">
      <h1>LabsCubed Knowledge Hub</h1>
      <p>{description}</p>
    </header>

    {categories.length > 0 && page.currentPage === 1 && (
      <nav class="bl-filters" aria-label="Categories">
        <a class="bl-filter" href={BLOG_BASE} aria-current="true">All</a>
        {categories.map((c) => (
          <a class="bl-filter" href={`${BLOG_BASE}/category/${c}`}>{categoryLabel(c)}</a>
        ))}
      </nav>
    )}

    <div class="bl-list">
      <div class="bl-grid">
        {page.data.map((p) => (
          <a class="bl-card" href={`${POST_BASE}/${p.slug}`}>
            {thumbImage(p) ? (
              <img
                class="bl-card__img"
                src={thumbImage(p)}
                alt={thumbAlt(p)}
                loading="lazy"
                decoding="async"
                width="600"
                height="338"
              />
            ) : (
              /* Posts awaiting their thumbnail still have to sit evenly in the
                 grid — an empty slot would collapse the card against its
                 neighbours. */
              <div class="bl-card__img bl-card__ph" aria-hidden="true">
                <span>{categoryLabel(p.categories[0] ?? 'LabsCubed')}</span>
              </div>
            )}
            <div class="bl-card__body">
              <div class="bl-card__top">
                <div class="bl-card__cats">
                  {p.categories.map((c) => <span class="bl-card__cat">{categoryLabel(c)}</span>)}
                </div>
                <span class="bl-card__read">{readTime(p)} min read</span>
              </div>
              <h2 class="bl-card__title">{p.title}</h2>
              {p.summary && <p class="bl-card__sum">{p.summary}</p>}
              <span class="bl-card__go" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>

    {(page.url.prev || page.url.next) && (
      <nav class="bl-pager" aria-label="Pagination">
        {page.url.prev ? <a href={page.url.prev}>← Newer</a> : <span />}
        <span>Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? <a href={page.url.next}>Older →</a> : <span />}
      </nav>
    )}

    <Footer />
  </main>
</Base>
