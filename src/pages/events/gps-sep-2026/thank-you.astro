---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../islands/Nav.tsx';
import ThankYouApp from '../../../components/ThankYouApp.jsx';
import Footer from '../../../components/Footer.astro';
import ScrollTopOnLoad from '../../../components/ScrollTopOnLoad.astro';
---

<Base title="Pick Your CubeOne Demo Time — Global Polymer Summit 2026" description="Choose your 30-minute CubeOne demonstration slot at the Global Polymer Summit. We will be waiting for you at Booth #815, Louisville, Kentucky, September 28–30 2026.">
  <ScrollTopOnLoad />
  {/* No countdown bar here — they have already registered. The header still
      sticks, matching the registration page. */}
  <div class="lc-sticky-top">
    <Nav client:load inFlow />
  </div>
  <main class="lc-page">
    <ThankYouApp slug="gps-sep-2026" client:only="react" />
  </main>
  <Footer showCta={false} />
</Base>

<style is:global>
  .lc-sticky-top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #000;
  }
</style>
