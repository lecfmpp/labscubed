---
/* Booth capture page — the tablet at Booth #815, not a page anyone should reach
   from search. It is noindex, excluded from the sitemap (astro.config.mjs), and
   carries no site header or footer: on a show floor every link is a way for the
   visitor to wander off mid-capture. */
import Base from '../../../../layouts/Base.astro';
import Nav from '../../../../islands/Nav.tsx';
import BoothCaptureApp from '../../../../components/BoothCaptureApp.jsx';
import Footer from '../../../../components/Footer.astro';
import ScrollTopOnLoad from '../../../../components/ScrollTopOnLoad.astro';
---

<Base
  title="Booth #815 — LabsCubed at the Global Polymer Summit"
  description="Leave your details at the LabsCubed booth and we'll email the material you pick."
  preloadHero={false}
  noindex
>
  <ScrollTopOnLoad />
  <div class="lc-sticky-top">
    <Nav client:load inFlow />
  </div>
  <main class="lc-page">
    <BoothCaptureApp slug="gps-sep-2026" client:only="react" />
  </main>
  <Footer showCta={false} />
</Base>

<style is:global>
  .lc-sticky-top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #000;
  }
</style>
