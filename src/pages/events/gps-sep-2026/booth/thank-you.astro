---
/* Booth capture confirmation. Same no-header treatment as the capture screen —
   the only control on it is "add another visitor", which is what the staff need
   between one handshake and the next. */
import Base from '../../../../layouts/Base.astro';
import Nav from '../../../../islands/Nav.tsx';
import BoothThankYou from '../../../../components/BoothThankYou.jsx';
import Footer from '../../../../components/Footer.astro';
import ScrollTopOnLoad from '../../../../components/ScrollTopOnLoad.astro';
---

<Base
  title="On its way — LabsCubed at Booth #815"
  description="Your material is on its way from the LabsCubed booth at the Global Polymer Summit."
  preloadHero={false}
  noindex
>
  <ScrollTopOnLoad />
  <div class="lc-sticky-top">
    <Nav client:load inFlow />
  </div>
  <main class="lc-page">
    <BoothThankYou slug="gps-sep-2026" client:only="react" />
  </main>
  <Footer showCta={false} />
</Base>

<style is:global>
  .lc-sticky-top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #000;
  }
</style>
