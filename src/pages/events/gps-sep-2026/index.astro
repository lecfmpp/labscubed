---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../islands/Nav.tsx';
import RegistrationApp from '../../../components/RegistrationApp.jsx';
import Footer from '../../../components/Footer.astro';
import ScrollTopOnLoad from '../../../components/ScrollTopOnLoad.astro';
---

<Base title="LabsCubed at the Global Polymer Summit 2026 — Event Recap" description="What we showed at the Global Polymer Summit 2026 in Louisville, September 28–30: CubeOne live at booth 815, what we heard from the rubber testing community, and our panel on AI and autonomous laboratories.">
  <ScrollTopOnLoad />
  {/* The show is over, so this is a recap page and no longer a booking page:
      no countdown bar, and the site header is back since there is nothing left
      to book. Same URL as before. */}
  <div class="lc-sticky-top">
    <Nav client:load inFlow />
  </div>
  <main class="lc-page">
    <RegistrationApp slug="gps-sep-2026" client:only="react" />
  </main>
  <Footer showCta={false} />
</Base>

<style is:global>
  .lc-sticky-top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #000;
  }

  /* Belt-and-braces for arrivals that skip the JS scroll helper — a
     /events/gps-sep-2026/#register link, or an in-page anchor. Keeps the top of
     the next-steps section clear of the sticky site header. */
  #register {
    scroll-margin-top: 70px;
  }

  @media (max-width: 760px) {
    #register {
      scroll-margin-top: 64px;
    }
  }
</style>
