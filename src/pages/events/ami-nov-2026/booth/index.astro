---
/* Booth capture page — the tablet at the stand, not a page anyone should reach
   from search. Noindex, out of the sitemap (astro.config.mjs), and sharing the
   booth block every show uses (webinarConfig.js). */
import Base from '../../../../layouts/Base.astro';
import Nav from '../../../../islands/Nav.tsx';
import BoothCaptureApp from '../../../../components/BoothCaptureApp.jsx';
import Footer from '../../../../components/Footer.astro';
import ScrollTopOnLoad from '../../../../components/ScrollTopOnLoad.astro';
---

<Base
  title="Booth — LabsCubed at the AMI Compounding World Expo"
  description="Leave your details at the LabsCubed booth at the AMI Compounding World Expo and we'll email the material you pick."
  preloadHero={false}
  noindex
>
  <ScrollTopOnLoad />
  <div class="lc-sticky-top">
    <Nav client:load inFlow />
  </div>
  <main class="lc-page">
    <BoothCaptureApp slug="ami-nov-2026" client:only="react" />
  </main>
  <Footer showCta={false} />
</Base>

<style is:global>
  .lc-sticky-top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #000;
  }
</style>
