   Serves the version 2 kiosk (LabAssessmentV2: badge/card scan, .com key, no country or
   website fields). The previous island, LabAssessment.tsx, is kept unused so this can be
   rolled back by switching the import. ../pre-assessment-v2 stays reachable and is identical. */
import Base from '../../../../layouts/Base.astro';
import LabAssessment from '../../../../islands/LabAssessmentV2.tsx';
---

<Base
  title="Lab assessment — LabsCubed at AMI Plastics World Expos"
  description="A few quick questions about your laboratory, so we can show you where automation could help."
  preloadHero={false}
  noindex
>
  <LabAssessment client:only="react" />
</Base>
