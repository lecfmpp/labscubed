---
/* /posts/page/2, /posts/page/3 … — pages 2 onward of the index.
 *
 * Page 1 is /posts (index.astro). Keeping the later pages under a /page/
 * segment means a paginated URL can never be mistaken for a post slug.
 */
import Base from '../../../layouts/Base.astro';
import Nav from '../../../islands/Nav.tsx';
import Footer from '../../../components/Footer.astro';
import '../../../styles/blog.css';
import { BLOG_HOST, BLOG_BASE, BLOG_STAGING, blogUrl } from '../../../site.mjs';
import {
  getPosts,
  categoryLabel,
  formatDate,
  postDate,
  readTime,
  thumbImage,
  thumbAlt,
} from '../../../lib/blog';
import { blogListingSchema } from '../../../lib/blog-schema';

/* Astro runs getStaticPaths in its own scope — it cannot see other frontmatter
   constants, so the page size is declared inside it and passed through props. */
export async function getStaticPaths() {
  const PAGE_SIZE = 12;
  const posts = await getPosts();
  const last = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
  // Page 1 is served by index.astro, so this route starts at 2.
  return Array.from({ length: Math.max(0, last - 1) }, (_, i) => {
    const n = i + 2;
    return { params: { page: String(n) }, props: { n, last, posts, pageSize: PAGE_SIZE } };
  });
}

const { n, last, posts, pageSize } = Astro.props;
const page = {
  data: posts.slice((n - 1) * pageSize, n * pageSize),
  currentPage: n,
  lastPage: last,
  url: {
    current: `${BLOG_BASE}/page/${n}`,
    prev: n === 2 ? BLOG_BASE : `${BLOG_BASE}/page/${n - 1}`,
    next: n < last ? `${BLOG_BASE}/page/${n + 1}` : undefined,
  },
};

const all = posts;

const title =
  page.currentPage === 1
    ? 'Blog LabsCubed | Automated Materials Testing Insights'
    : `Blog LabsCubed | Page ${page.currentPage}`;
const description =
  'Guides on automated tensile testing, ASTM and ISO methods, polymer and rubber QA workflows, and lab automation — from the LabsCubed engineering team.';
const canonical = `${BLOG_HOST}${page.url.current}`;

/* rel=prev/next so paginated pages are read as one series rather than as
   near-duplicate listings competing with each other. */
const headExtra = [
  page.url.prev
    ? `<link rel="prev" href="${BLOG_HOST}${page.url.prev}" />`
    : '',
  page.url.next
    ? `<link rel="next" href="${BLOG_HOST}${page.url.next}" />`
    : '',
].join('');

const categories = [...new Set(all.flatMap((p) => p.categories))].sort();
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={[blogListingSchema(all, BLOG_HOST)]}
  preloadHero={false}
  headExtra={headExtra}
  noindex={BLOG_STAGING}
>
  <Nav client:load light />

  <main class="lc-page">
    <header class="bl-head">
      <h1>LabsCubed Blog</h1>
      <p>{description}</p>
    </header>

    {false && (
      <nav class="bl-filters" aria-label="Categories">
        <a class="bl-filter" href={BLOG_BASE} aria-current="true">All</a>
        {categories.map((c) => (
          <a class="bl-filter" href={`${BLOG_BASE}/category/${c}`}>{categoryLabel(c)}</a>
        ))}
      </nav>
    )}

    <div class="bl-list">
      <div class="bl-grid">
        {page.data.map((p) => (
          <a class="bl-card" href={`${BLOG_BASE}/${p.slug}`}>
            {thumbImage(p) ? (
              <img
                class="bl-card__img"
                src={thumbImage(p)}
                alt={thumbAlt(p)}
                loading="lazy"
                decoding="async"
                width="600"
                height="338"
              />
            ) : (
              /* Posts awaiting their thumbnail still have to sit evenly in the
                 grid — an empty slot would collapse the card against its
                 neighbours. */
              <div class="bl-card__img bl-card__ph" aria-hidden="true">
                <span>{categoryLabel(p.categories[0] ?? 'LabsCubed')}</span>
              </div>
            )}
            <div class="bl-card__body">
              <div class="bl-card__top">
                <div class="bl-card__cats">
                  {p.categories.map((c) => <span class="bl-card__cat">{categoryLabel(c)}</span>)}
                </div>
                <span class="bl-card__read">{readTime(p)} min read</span>
              </div>
              <h2 class="bl-card__title">{p.title}</h2>
              {p.summary && <p class="bl-card__sum">{p.summary}</p>}
              <span class="bl-card__go" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>

    {(page.url.prev || page.url.next) && (
      <nav class="bl-pager" aria-label="Pagination">
        {page.url.prev ? <a href={page.url.prev}>← Newer</a> : <span />}
        <span>Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? <a href={page.url.next}>Older →</a> : <span />}
      </nav>
    )}

    <Footer />
  </main>
</Base>
