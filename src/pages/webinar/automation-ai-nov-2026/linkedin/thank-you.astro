---
import Base from '../../../../layouts/Base.astro';
import Nav from '../../../../islands/Nav.tsx';
import ThankYouApp from '../../../../components/ThankYouApp.jsx';
import Footer from '../../../../components/Footer.astro';
import ScrollTopOnLoad from '../../../../components/ScrollTopOnLoad.astro';
---

{/* LinkedIn conversion page: the Insight Tag (Analytics.astro) is on every page,
    and Campaign Manager counts a registration when this URL loads. */}
<Base title="You're Registered — The Role of AI in Materials Testing" noindex description="You are registered for the LabsCubed webinar on Wednesday December 2 2026 at 11:00 AM EST.">
  <ScrollTopOnLoad />
  {/* No countdown bar here — they have already registered. The header still
      sticks, matching the registration page. */}
  <div class="lc-sticky-top">
    <Nav client:load inFlow />
  </div>
  <main class="lc-page">
    <ThankYouApp slug="automation-ai-nov-2026" client:only="react" />
  </main>
  <Footer showCta={false} />
</Base>

<style is:global>
  .lc-sticky-top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #000;
  }
</style>
