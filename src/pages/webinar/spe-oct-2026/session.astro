---
import Base from '../../../layouts/Base.astro';
import SessionApp from '../../../components/SessionApp.jsx';
import Footer from '../../../components/Footer.astro';
import ScrollTopOnLoad from '../../../components/ScrollTopOnLoad.astro';
---

<Base title="Your Session — The Hidden Cost of Manual Plastics Testing" description="Your session of the LabsCubed webinar." noindex>
  <ScrollTopOnLoad />
  {/* Personal, gated page: the ?t= access token in the link is what lets a
      visitor in. No site header — the session is the whole page. */}
  <main class="lc-page">
    <SessionApp slug="spe-oct-2026" client:only="react" />
  </main>
  <Footer showCta={false} />
</Base>
