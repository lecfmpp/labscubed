---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../islands/Nav.tsx';
import RegistrationApp from '../../../components/RegistrationApp.jsx';
import Footer from '../../../components/Footer.astro';
import ScrollTopOnLoad from '../../../components/ScrollTopOnLoad.astro';
---

<Base title="Watch the Replay — The Hidden Cost of Manual Plastics Testing — LabsCubed Webinar" description="Watch the replay of our SPE webinar, first aired October 20 2026. Where the hidden costs and variability sit in manual plastics tensile testing, and what automation changes. With real CubeTen data on HIPS and polypropylene.">
  <ScrollTopOnLoad />
  {/* The session has aired, so this is a replay page and no longer a
      registration page: the countdown bar is gone and the site header is back,
      since there is nothing left to register for. Same URL as before. */}
  <div class="lc-sticky-top">
    <Nav client:load inFlow />
  </div>
  <main class="lc-page">
    <RegistrationApp slug="spe-oct-2026" client:only="react" />
  </main>
  <Footer showCta={false} />
</Base>

<style is:global>
  .lc-sticky-top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #000;
  }

  /* Belt-and-braces for arrivals that skip the JS scroll helper — a
     /webinar/spe-oct-2026/#register link, or an in-page anchor. Keeps the next
     steps section clear of the sticky site header. */
  #register {
    scroll-margin-top: 70px;
  }

  @media (max-width: 760px) {
    #register {
      scroll-margin-top: 64px;
    }
  }
</style>
