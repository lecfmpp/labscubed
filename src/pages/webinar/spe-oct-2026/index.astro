---
import Base from '../../../layouts/Base.astro';
import WebinarTopBar from '../../../components/WebinarTopBar.jsx';
import RegistrationApp from '../../../components/RegistrationApp.jsx';
import Footer from '../../../components/Footer.astro';
import ScrollTopOnLoad from '../../../components/ScrollTopOnLoad.astro';
---

<Base title="The Hidden Cost of Manual Plastics Testing — LabsCubed Webinar" description="Free webinar, Tuesday October 20 2026 at 11:00 AM EST. Where the hidden costs and variability sit in manual plastics tensile testing, and what automation changes. With real CubeTen data on HIPS and polypropylene.">
  <ScrollTopOnLoad />
  {/* No site header on this page on purpose: every link in it is a way to
      leave, and the page has one job — registration. The countdown bar stays,
      sticky on its own. The thank-you page keeps the header, since by then the
      conversion has happened. */}
  <div class="lc-sticky-top">
    <WebinarTopBar slug="spe-oct-2026" client:only="react" />
  </div>
  <main class="lc-page">
    <RegistrationApp slug="spe-oct-2026" client:only="react" />
  </main>
  <Footer showCta={false} />
</Base>

<style is:global>
  .lc-sticky-top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #000;
  }

  /* Belt-and-braces for arrivals that skip the JS scroll helper — a
     /webinar/spe-oct-2026/#register link, or an in-page anchor. Keeps the top of
     the registration section clear of the sticky countdown bar, measured at
     57px now that the site header is gone from this page. */
  #register {
    scroll-margin-top: 70px;
  }

  @media (max-width: 760px) {
    #register {
      scroll-margin-top: 64px;
    }
  }
</style>
