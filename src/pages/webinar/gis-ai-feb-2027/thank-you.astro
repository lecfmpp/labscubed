---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../islands/Nav.tsx';
import ThankYouApp from '../../../components/ThankYouApp.jsx';
import Footer from '../../../components/Footer.astro';
import ScrollTopOnLoad from '../../../components/ScrollTopOnLoad.astro';
---

<Base title="You're Registered — Automation, AI and Industry 4.0 in the Testing Lab" description="You are registered for the LabsCubed webinar on Tuesday February 16 2027 at 8:00 PM EST." noindex>
  <ScrollTopOnLoad />
  {/* No countdown bar here — they have already registered. The header still
      sticks, matching the registration page. */}
  <div class="lc-sticky-top">
    <Nav client:load inFlow />
  </div>
  <main class="lc-page">
    <ThankYouApp slug="gis-ai-feb-2027" client:only="react" />
  </main>
  <Footer showCta={false} />
</Base>

<style is:global>
  .lc-sticky-top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #000;
  }
</style>
