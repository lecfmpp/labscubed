---
/* Shell for the legal pages (privacy policy, and whatever follows it off
   Webflow). Dark hero + a two-column body: a sticky section index on desktop,
   the same index inside a <details> on mobile, and the prose itself.

   Every legal page is one long numbered document, so the index is the whole
   navigation — there is no other way to reach section 11 of 14 without
   scrolling past ten. It is plain anchors, so it costs no JS. */
import Base from './Base.astro';
import Nav from '../islands/Nav.tsx';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  heading: string;
  updated: string;
  sections: { id: string; label: string }[];
  jsonLd?: unknown[];
}
const { title, description, canonical, heading, updated, sections, jsonLd } = Astro.props;
---
<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd} preloadHero={false}>
  <Nav client:load />
  <main class="lc-page">
    <section class="lg-hero">
      <span class="lg-hero__glow" aria-hidden="true"></span>
      <div class="lg-hero__inner">
        <div class="lg-hero__eyebrow">Legal</div>
        <h1 class="lg-hero__h1">{heading}</h1>
        <p class="lg-hero__meta">Last updated {updated}</p>
      </div>
    </section>

    <div class="lg-body">
      <div class="lg-body__inner">
        <details class="lg-toc-m">
          <summary>Jump to a section</summary>
          <ol>
            {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
          </ol>
        </details>

        <nav class="lg-toc" aria-label="Sections">
          <div class="lg-toc__label">Contents</div>
          <ol>
            {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
          </ol>
        </nav>

        <article class="lg-prose"><slot /></article>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  /* ---- Hero: the About page's black band, at a calmer size. A legal notice
     does not need an 80px headline. ---- */
  .lg-hero { background: #000; color: #fff; position: relative; overflow: hidden; }
  .lg-hero__glow {
    position: absolute; top: -280px; left: 50%; transform: translateX(-50%);
    width: 1100px; height: 700px; pointer-events: none;
    background: radial-gradient(closest-side, rgba(23,221,197,0.16), rgba(23,221,197,0));
  }
  .lg-hero__inner { position: relative; max-width: 1312px; margin: 0 auto; padding: 170px 64px 90px; box-sizing: border-box; }
  .lg-hero__eyebrow { font-weight: 700; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
  .lg-hero__h1 { font-weight: 700; font-size: 56px; line-height: 1.06; letter-spacing: -0.03em; margin: 20px 0 0; }
  .lg-hero__meta { margin: 18px 0 0; font-size: 15px; font-weight: 300; color: rgba(255,255,255,0.55); }

  /* ---- Body shell ---- */
  .lg-body { background: #fff; color: var(--lc-ink); }
  .lg-body__inner {
    max-width: 1312px; margin: 0 auto; padding: 80px 64px 140px; box-sizing: border-box;
    display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 72px; align-items: start;
  }

  /* ---- Sticky index (desktop) ---- */
  .lg-toc { position: sticky; top: 104px; }
  .lg-toc__label { font-weight: 700; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 18px; }
  .lg-toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; max-height: calc(100vh - 180px); overflow-y: auto; }
  .lg-toc a {
    display: block; padding: 7px 12px; border-radius: 8px; text-decoration: none;
    font-size: 13px; line-height: 1.4; font-weight: 400; color: var(--text-muted);
    border-left: 2px solid transparent; transition: background .15s ease, color .15s ease;
  }
  .lg-toc a:hover { background: var(--lc-gray-100); color: var(--lc-ink); }
  .lg-toc a:target, .lg-toc a:focus-visible { color: var(--lc-ink); }

  /* ---- Mobile index ---- */
  .lg-toc-m { display: none; border: 1px solid var(--lc-line-strong); border-radius: 16px; padding: 16px 18px; margin-bottom: 40px; background: var(--lc-gray-100); }
  .lg-toc-m summary { cursor: pointer; font-weight: 600; font-size: 14px; }
  .lg-toc-m ol { margin: 14px 0 4px; padding-left: 18px; display: flex; flex-direction: column; gap: 8px; }
  .lg-toc-m a { font-size: 14px; line-height: 1.45; color: var(--text-muted); text-decoration: none; }

  /* ---- Prose. Deliberately narrow: a 14-section legal notice is read, not
     skimmed, and full-width lines of 12px-leading legalese are unreadable. ---- */
  .lg-prose { max-width: 760px; }
  .lg-prose :global(h2) {
    font-weight: 700; font-size: 24px; line-height: 1.25; letter-spacing: -0.02em;
    margin: 64px 0 0; padding-top: 34px; border-top: 1px solid var(--lc-line-strong);
    scroll-margin-top: 96px; color: var(--lc-ink);
  }
  .lg-prose :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: none; }
  .lg-prose :global(h3) { font-weight: 700; font-size: 18px; line-height: 1.35; margin: 40px 0 0; color: var(--lc-ink); }
  .lg-prose :global(h4) { font-weight: 600; font-size: 16px; line-height: 1.4; margin: 30px 0 0; color: var(--lc-ink); }
  .lg-prose :global(p) { font-weight: 300; font-size: 16px; line-height: 1.7; color: var(--text-muted); margin: 16px 0 0; }
  .lg-prose :global(strong) { font-weight: 600; color: var(--lc-ink); }
  .lg-prose :global(ul) { margin: 16px 0 0; padding-left: 22px; display: flex; flex-direction: column; gap: 10px; }
  .lg-prose :global(li) { font-weight: 300; font-size: 16px; line-height: 1.7; color: var(--text-muted); }
  .lg-prose :global(li::marker) { color: var(--lc-teal-deep); }
  .lg-prose :global(a) { color: var(--lc-teal-deep); text-decoration: underline; text-underline-offset: 2px; overflow-wrap: anywhere; }
  .lg-prose :global(a:hover) { color: var(--lc-ink); }

  /* The source document opens almost every section with an "In Short" summary.
     It is the most useful thing in the notice, so it is pulled out of the run
     of body text rather than left as another italic paragraph. */
  .lg-prose :global(.pp-short) {
    margin: 22px 0 0; padding: 16px 20px; border-radius: 12px;
    background: var(--lc-gray-100); border-left: 3px solid var(--lc-teal);
    color: var(--lc-ink); font-weight: 400; font-size: 15px; line-height: 1.6;
  }
  .lg-prose :global(.pp-short__tag) {
    display: block; font-weight: 700; font-size: 10px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--lc-teal-deep); margin-bottom: 6px;
  }

  @media (max-width: 1000px) {
    .lg-body__inner { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .lg-toc { display: none; }
    .lg-toc-m { display: block; }
  }
  @media (max-width: 760px) {
    .lg-hero__inner { padding: 110px 20px 56px; }
    .lg-hero__h1 { font-size: 34px; }
    .lg-body__inner { padding: 48px 20px 72px; }
    .lg-prose :global(h2) { font-size: 21px; margin-top: 48px; padding-top: 28px; }
    .lg-prose :global(p), .lg-prose :global(li) { font-size: 15px; }
  }
</style>
