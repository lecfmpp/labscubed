---
import '../styles/styles.css';
import { SITE_URL } from '../site.mjs';
import { buildJsonLd } from '../lib/jsonld';

interface Props {
  title?: string;
  description?: string;
  /** Absolute og/twitter image. Defaults to the CubeTen hero. */
  ogImage?: string;
  /** 'website' for the homepage, 'article' for blog posts. */
  ogType?: string;
  /** Absolute canonical. Defaults to SITE_URL + current path. Blog pages pass
   *  the www origin explicitly to preserve the URLs already indexed. */
  canonical?: string;
  /** Replaces the homepage Organization/Product/FAQ blocks when supplied. */
  jsonLd?: unknown[];
  /** The hero preload only helps the homepage; every other page would be
   *  preloading an image it never renders, which Lighthouse flags as waste. */
  preloadHero?: boolean;
  /** Extra <head> markup (e.g. prev/next rel links on paginated listings). */
  headExtra?: string;
  /** Keep the page out of the index — used for the staging blog host. */
  noindex?: boolean;
  /** Which face to preload. Blog pages render in Inter Tight, so preloading
   *  Inter there would fetch a font the page never draws while the one it does
   *  need is discovered late, after the stylesheet parses. */
  preloadFont?: 'inter' | 'inter-tight';
}
const {
  title = 'LabsCubed — Automated tensile testing for polymer and rubber labs',
  description = 'Automated, ISO- and ASTM-compliant tensile testing for polymer and rubber labs — repeatable results that free your team from repetitive testing.',
  ogImage: ogImageProp,
  ogType = 'website',
  canonical: canonicalProp,
  jsonLd: jsonLdProp,
  preloadHero = true,
  headExtra,
  noindex = false,
  preloadFont = 'inter',
} = Astro.props;

/* Head resource hints — why there are preloads and no preconnects.

   Preloads: the Inter woff2 and the LCP hero image are both needed for the
   first paint, and the browser discovers both late on its own — the font only
   once it has downloaded and parsed the stylesheet, the hero only once the
   parser reaches it in the body. The preloads start them in parallel with the
   stylesheet instead. The hero preload carries the same srcset/sizes as the
   <img> in Hero.astro; if one changes the other has to change with it, or the
   browser preloads a candidate it then discards.

   Preconnects: deliberately none. The page used to preconnect to
   fonts.googleapis.com, fonts.gstatic.com, www.youtube.com and img.youtube.com.
   Inter is now self-hosted and the carousel's video titles and thumbnails are
   baked in at build time, so the page makes no third-party requests during load
   and every one of those handshakes was pure overhead — Lighthouse was already
   flagging img.youtube.com as an unused preconnect. */
const canonical = canonicalProp ?? new URL(Astro.url.pathname, SITE_URL).href;
const ogImage =
  ogImageProp ?? new URL('/assets/img/media/hero-cubeten.webp', SITE_URL).href;
const jsonLd = jsonLdProp ?? buildJsonLd(SITE_URL);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="LabsCubed" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Preload the two assets the first paint needs — see the note in frontmatter. */}
    <link
      rel="preload"
      href={`/assets/fonts/${preloadFont}-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {preloadHero && (
      <link
        rel="preload"
        href="/assets/img/media/hero-cubeten-crop-760.webp"
        as="image"
        type="image/webp"
        fetchpriority="high"
        imagesrcset="/assets/img/media/hero-cubeten-crop-480.webp 480w, /assets/img/media/hero-cubeten-crop-760.webp 760w, /assets/img/media/hero-cubeten-crop.webp 1500w"
        imagesizes="(max-width: 760px) 64vw, min(55.5vw, 708px)"
      />
    )}

    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {headExtra && <Fragment set:html={headExtra} />}
  </head>
  <body>
    <slot />
  </body>
</html>
